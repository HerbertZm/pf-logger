{
  "name": "pf-logger",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"ts-node-dev --respawn --transpile-only src/server.ts\" \"vite client\"",
    "build": "tsc -p tsconfig.build.json && vite build client",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client/tsconfig.json",
    "lint": "eslint src client/src --ext .ts,.tsx",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.106.2",
    "@types/better-sqlite3": "^7.6.13",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "prisma": {
    "schema": "src/db/schema.prisma",
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} src/db/seed.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.3",
    "prisma": "^7.8.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.16"
  }
}
