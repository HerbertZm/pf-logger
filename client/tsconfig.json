{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "rootDir": "src",
    "baseUrl": "src",
    "noUncheckedIndexedAccess": false
  },
  "include": ["src"],
  "exclude": []
}
